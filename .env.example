# ============================================================================
# BESO PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/beso_production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beso_production
DB_USER=postgres
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# ============================================================================
# CACHE (Redis)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=beso:

# ============================================================================
# AUTHENTICATION & JWT
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_characters
JWT_EXPIRY=3600                    # 1 hour (seconds)
JWT_REFRESH_EXPIRY=604800          # 7 days (seconds)
BCRYPT_ROUNDS=12

# ============================================================================
# SESSION & SECURITY
# ============================================================================
SESSION_SECRET=your_session_secret_change_in_production
CORS_ORIGIN=http://localhost:3000,https://beso.app
RATE_LIMIT_WINDOW=900000           # 15 minutes (milliseconds)
RATE_LIMIT_MAX_REQUESTS=100        # per window

# ============================================================================
# EMAIL SERVICE
# ============================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@beso.app

# ============================================================================
# PAYMENT & FINANCIAL
# ============================================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Commission Splits (Percentages)
PLATFORM_COMMISSION_PCT=30         # Platform takes 30%
HOST_EARNINGS_PCT=70               # Host gets 70%
AGENCY_DEFAULT_COMMISSION_PCT=20   # Agency takes 20% from host

# Withdrawal Limits
WITHDRAWAL_MIN_AMOUNT=10.00
WITHDRAWAL_MAX_AMOUNT=10000.00
WITHDRAWAL_PROCESSING_FEE_PCT=2.00

# ============================================================================
# WEBSOCKET & REAL-TIME
# ============================================================================
WEBSOCKET_PING_INTERVAL=25000      # 25 seconds
WEBSOCKET_PING_TIMEOUT=5000        # 5 seconds
WEBSOCKET_ADAPTER=redis            # redis or memory

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_FILE_PATH=./logs/beso.log
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=14

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_2FA=false
ENABLE_WITHDRAWAL=true
ENABLE_GIFT_ANIMATIONS=true
ENABLE_LOVE_TREE=true
ENABLE_QUEST_SYSTEM=true
ENABLE_ANALYTICS=true

# ============================================================================
# REGIONAL SETTINGS
# ============================================================================
DEFAULT_CURRENCY=USD
SUPPORTED_PAYOUT_METHODS=bank_transfer,vodafone_cash,mobile_money
SUPPORTED_COUNTRIES=EG,AE,SA

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
AWS_S3_BUCKET=beso-platform-assets

# ============================================================================
# DEVELOPMENT / DEBUG
# ============================================================================
DEBUG=false
MOCK_PAYMENT_GATEWAY=false
SEED_TEST_DATA=false
